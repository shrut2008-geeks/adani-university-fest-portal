# Server Environment Configuration
PORT=5000

# PostgreSQL Database Connection String (Neon or local)
DATABASE_URL=postgresql://user:change_me@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for token signing and verification
JWT_SECRET=change_me_super_secret_jwt_key_here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Telegram Alert Configuration (Optional)
TELEGRAM_BOT_TOKEN=change_me_bot_token
TELEGRAM_CHAT_ID=change_me_chat_id
